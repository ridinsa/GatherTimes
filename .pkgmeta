# Packager settings for the flat layout: every addon folder sits at the top of the repo.
# Check the packager log after the first run to confirm all nine addon folders are in the zip.
# Only one changelog can go on the project page: GatherTimes' changelog is used.

changelog: GatherTimes/CHANGELOG.md
changelog-markup: markdown

# Files and folders in the repo that should not ship in the addon zip.
ignore:
  - README.md
  - .gitignore
  - .gitattributes
  - .github
  - "*.zip"
  - "*.md"
  - Tests
  - Libs/README.txt

# The libraries are already bundled in each Libs/ folder (the .toc files load them from there),
# so no externals are needed.
